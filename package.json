{
  "name": "hector-workout-tracker",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "http-server . -a 127.0.0.1 -p 4175 -c-1",
    "serve:lan": "http-server . -a 0.0.0.0 -p 4175",
    "lint": "eslint .",
    "format:check": "prettier --check . --end-of-line auto",
    "catalog:refresh": "node scripts/refresh-exercise-catalog.mjs",
    "catalog:validate": "node scripts/validate-exercise-catalog.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run format:check && npm run release:check && npm run catalog:validate && npm run test:backend && npm run test",
    "test:backend": "node --test \"backend/cloudflare-worker/tests/*.test.js\"",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/prepare-release.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@playwright/test": "~1.61.1",
    "eslint": "~10.6.0",
    "globals": "~17.7.0",
    "http-server": "~14.1.1",
    "prettier": "~3.9.4"
  }
}
